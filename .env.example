# ============================================
# SUPABASE
# Copy this file to .env and replace the placeholders with your own project's
# values (Project Settings → API in the Supabase dashboard).
# NOTE: the anon/publishable key is safe to expose to the browser (RLS is the
# real security boundary). Do NOT put the service_role key here — it is
# server-only and belongs in Supabase Edge Function secrets.
# ============================================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY

# ============================================
# PAYSTACK (Nigerian Payments)
# Get from: https://dashboard.paystack.com/#/settings/api
#
# IMPORTANT: Replace ALL placeholder values below with your real Paystack
# credentials before going live. The app will not process payments with
# placeholder values. Secret keys (sk_*) must ONLY be set as Supabase
# Edge Function secrets, never in client env vars.
# ============================================
VITE_PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_PUBLIC_KEY

# Paystack Subscription Page URLs (create in Paystack dashboard)
VITE_PAYSTACK_STARTER_PAGE=https://paystack.com/pay/REPLACE_STARTER_SLUG
VITE_PAYSTACK_BUSINESS_PAGE=https://paystack.com/pay/REPLACE_BUSINESS_SLUG
VITE_PAYSTACK_PRO_PAGE=https://paystack.com/pay/REPLACE_PRO_SLUG

# Paystack Plan Codes (create via Paystack API or dashboard)
# These are used by the server-side Edge Function, not the client
VITE_PAYSTACK_PLAN_STARTER=PLN_REPLACE_STARTER
VITE_PAYSTACK_PLAN_BUSINESS=PLN_REPLACE_BUSINESS
VITE_PAYSTACK_PLAN_PRO=PLN_REPLACE_PRO

# ============================================
# SENTRY (optional runtime error reporting)
# Get from: https://sentry.io -> Project Settings -> Client Keys (DSN)
# When unset, the Sentry SDK is never downloaded and every capture call is a
# no-op (the first-party errorCapture + platform_error_events feed always
# runs regardless). When set, the SDK loads lazily during browser idle time
# so it never slows first paint.
# ============================================
VITE_SENTRY_DSN=

# ============================================
# META PIXEL (optional ad conversion tracking)
# Get from: Meta Events Manager -> Data Sources -> your pixel ID.
# When unset, no pixel script is ever injected and every track call is a
# no-op. Purchase events fire ONLY on server-verified payment success
# (paystack-verify), never on a button click.
# ============================================
VITE_META_PIXEL_ID=
