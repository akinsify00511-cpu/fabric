# ============================================
# PAYSTACK (Nigerian Payments)
# Get from: https://dashboard.paystack.com/#/settings/api
#
# IMPORTANT: Replace ALL placeholder values below with your real Paystack
# credentials before going live. The app will not process payments with
# placeholder values. Secret keys (sk_*) must ONLY be set as Supabase
# Edge Function secrets, never in client env vars.
# ============================================
VITE_PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_PUBLIC_KEY

# Paystack Subscription Page URLs (create in Paystack dashboard)
VITE_PAYSTACK_STARTER_PAGE=https://paystack.com/pay/REPLACE_STARTER_SLUG
VITE_PAYSTACK_BUSINESS_PAGE=https://paystack.com/pay/REPLACE_BUSINESS_SLUG
VITE_PAYSTACK_PRO_PAGE=https://paystack.com/pay/REPLACE_PRO_SLUG

# Paystack Plan Codes (create via Paystack API or dashboard)
# These are used by the server-side Edge Function, not the client
VITE_PAYSTACK_PLAN_STARTER=PLN_REPLACE_STARTER
VITE_PAYSTACK_PLAN_BUSINESS=PLN_REPLACE_BUSINESS
VITE_PAYSTACK_PLAN_PRO=PLN_REPLACE_PRO
